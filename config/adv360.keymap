#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hml: homerow_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <69 70 66 65 55 54 57 56 58 41 40 44 43 42 22 23 24 25 26>;
        };

        mod_tap: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        hmr: homerow_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <66 65 69 70 47 48 49 50 51 29 31 30 32 33 19 18 17 16 15>;
        };

        comma_shift_semi: comma_shift_semi {
            compatible = "zmk,behavior-mod-morph";
            label = ", ;";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        period_shift_colon: period_shift_colon {
            compatible = "zmk,behavior-mod-morph";
            label = ". :";
            bindings = <&kp PERIOD>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_curly {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <23 24>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <24 25>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <18 17>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <17 16>;
        };

        left_paren {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <55 56>;
        };

        right_paren {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <56 57>;
        };

        double_quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <23 25>;
        };

        single_quote {
            bindings = <&kp SQT>;
            key-positions = <57 55>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <18 16>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <48 50>;
        };

        forward_slash {
            bindings = <&kp LESS_THAN>;
            key-positions = <71 72>;
        };

        backslash {
            bindings = <&kp GREATER_THAN>;
            key-positions = <72 73>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <63 64>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <62 63>;
        };
    };

    macros {
        command_palette: command_palette {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LA(LEFT_WIN)>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LA(LEFT_WIN)>;

            label = "COMMAND_PALETTE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1           &kp N2       &kp N3        &kp N4        &kp N5  &tog 1                                                                &mo 2                 &kp N6  &kp N7        &kp N8             &kp N9               &kp N0            &kp MINUS
&kp TAB    &kp Q            &kp W        &kp F         &kp P         &kp B   &none                                                                 &none                 &kp J   &kp L         &kp U              &kp Y                &kp SEMICOLON     &kp BSLH
&kp ESC    &hml LEFT_WIN A  &hml LALT R  &hml LSHFT S  &hml LCTRL T  &kp G   &none             &kp LCTRL       &kp LALT      &kp LGUI   &kp RCTRL  &none                 &kp M   &hmr RCTRL N  &hmr RSHFT E       &hmr LEFT_ALT I      &hmr RIGHT_WIN O  &kp SQT
&kp LSHFT  &kp Z            &kp X        &kp C         &kp D         &kp V                                     &kp HOME      &kp PG_UP                                   &kp K   &kp H         &comma_shift_semi  &period_shift_colon  &kp FSLH          &kp RSHFT
&to 6      &kp GRAVE        &kp CAPS     &kp LEFT      &kp RIGHT             &mod_tap 3 SPACE  &mod_tap 5 TAB  &kp END       &kp PG_DN  &kp ENTER  &mod_tap 4 BACKSPACE          &kp UP        &kp DOWN           &kp LBKT             &kp RBKT          &to 7
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 2      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 0      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 0
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        nav {
            display-name = "nav";
            bindings = <
&none  &kp F1        &kp F2        &kp F3      &kp F4     &kp F5  &none                                                 &none          &kp F6    &kp F7         &kp F8        &kp F9     &kp F10     &kp F11
&none  &none         &none         &kp X       &none      &none   &none                                                 &none          &none     &kp LC(V)      &kp LC(C)     &kp LC(X)  &kp LC(Z)   &kp F12
&none  &kp LEFT_WIN  &kp LEFT_ALT  &kp LSHIFT  &kp LCTRL  &none   &none  &none  &none      &command_palette  &none      &none          &kp LEFT  &kp DOWN       &kp UP_ARROW  &kp RIGHT  &kp END     &none
&none  &kp HASH      &none         &none       &none      &none                 &none      &none                                       &kp HOME  &kp PAGE_DOWN  &kp PG_UP     &kp INS    &kp DELETE  &none
&none  &none         &none         &none       &none              &none  &none  &none      &none             &kp ENTER  &kp BACKSPACE            &none          &none         &none      &none       &none
            >;
        };

        num {
            display-name = "num";
            bindings = <
&none  &kp F1     &kp F2  &kp F3  &kp F4  &kp F5     &none                                                  &none  &kp F6  &kp F7     &kp F8     &kp F9    &kp F10   &kp F11
&none  &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT   &none                                                  &none  &none   &none      &none      &none     &none     &kp F12
&none  &kp SEMI   &kp N4  &kp N5  &kp N6  &kp EQUAL  &none   &none      &none      &command_palette  &none  &none  &none   &kp LCTRL  &kp LSHFT  &kp LALT  &kp LGUI  &none
&none  &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp BSLH                      &none      &none                           &none   &none      &kp COMMA  &kp RALT  &none     &none
&none  &kp GRAVE  &none   &none   &none              &kp N0  &kp MINUS  &none      &none             &none  &none          &none      &none      &none     &none     &none
            >;
        };

        media {
            bindings = <
&none  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none                                                  &none             &kp F6  &kp F7          &kp F8             &kp F9           &kp F10             &kp F11
&none  &none   &none   &none   &none   &none   &none                                                  &none             &none   &none           &bl BL_TOG         &bl BL_DEC       &bl BL_INC          &kp F12
&none  &none   &none   &none   &none   &none   &none  &none  &none      &command_palette  &none       &none             &none   &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT          &none
&none  &none   &none   &none   &none   &none                 &none      &none                                           &none   &kp C_REWIND    &kp C_MUTE         &none            &kp C_FAST_FORWARD  &none
&none  &none   &none   &none   &none           &none  &none  &none      &none             &kp C_STOP  &kp C_PLAY_PAUSE          &none           &none              &none            &none               &none
            >;
        };

        Qwerty {
            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                         &mo 2                 &kp N6  &kp N7  &kp N8             &kp N9               &kp N0         &kp MINUS
&kp ESCAPE        &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                          &none                 &kp Y   &kp U   &kp I              &kp O                &kp P          &kp BSLH
&kp TAB           &kp A      &kp S     &kp D     &kp F      &kp G   &none      &kp LCTRL       &kp LALT      &kp LGUI   &kp RCTRL  &none                 &kp H   &kp J   &kp K              &kp L                &kp SEMICOLON  &kp SQT
&kp LSHFT         &kp Z      &kp X     &kp C     &kp V      &kp B                              &kp HOME      &kp PG_UP                                   &kp N   &kp M   &comma_shift_semi  &period_shift_colon  &kp FSLH       &kp RSHFT
&kp LEFT_CONTROL  &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp SPACE  &mod_tap 5 TAB  &kp END       &kp PG_DN  &kp ENTER  &mod_tap 4 BACKSPACE          &kp UP  &kp DOWN           &kp LBKT             &kp RBKT       &to 0
            >;
        };

        Gaming {
            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp N1          &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                    &mo 2                 &kp N6  &kp N7  &kp N8             &kp N9               &kp N0         &kp MINUS
&kp ESCAPE        &kp ESCAPE      &kp Q     &kp W     &kp E      &kp R   &none                                                     &none                 &kp Y   &kp U   &kp I              &kp O                &kp P          &kp BSLH
&kp TAB           &kp LEFT_SHIFT  &kp A     &kp S     &kp D      &kp F   &kp G      &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none                 &kp H   &kp J   &kp K              &kp L                &kp SEMICOLON  &kp SQT
&kp LCTRL         &kp Z           &kp Z     &kp X     &kp C      &kp V                         &kp HOME      &kp PG_UP                                   &kp N   &kp M   &comma_shift_semi  &period_shift_colon  &kp FSLH       &kp RSHFT
&kp LEFT_CONTROL  &kp GRAVE       &kp CAPS  &kp LEFT  &kp RIGHT          &kp SPACE  &kp G      &kp END       &kp PG_DN  &kp ENTER  &mod_tap 4 BACKSPACE          &kp UP  &kp DOWN           &kp LBKT             &kp RBKT       &to 0
            >;
        };
    };
};
